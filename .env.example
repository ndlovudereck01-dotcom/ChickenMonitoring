# ---------------------------------------------------------------------------
# Chicken Vision — environment configuration
# Copy to .env and edit. Never commit the real .env file.
# ---------------------------------------------------------------------------

# Required in production. Generate one with:
#   python -c "from secrets import token_urlsafe; print(token_urlsafe(50))"
DJANGO_SECRET_KEY=

# 1 for local development, 0 for production (enables HSTS, secure cookies, SSL redirect)
DJANGO_DEBUG=0

# Comma separated hostnames serving the app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma separated scheme://host[:port] allowed to POST with CSRF, e.g. https://farm.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

DJANGO_TIME_ZONE=UTC
DJANGO_LANGUAGE_CODE=en-us

# Set to 1 when TLS terminates at a reverse proxy (nginx, Caddy)
DJANGO_BEHIND_TLS_PROXY=0

# ---------------------------------------------------------------------------
# Detection model
# ---------------------------------------------------------------------------
# Path to YOLOv11 weights. Train a chicken-specific model (recommended) with:
#   python manage.py train_model --data datasets/chickens.yaml
# Falls back to yolo11n.pt (COCO "bird" class) when the file is missing.
CHICKEN_MODEL_PATH=models/chicken_yolo11.pt
# Dataset edited by the Training data page and read by `manage.py train_model`.
CHICKEN_DATASET_DIR=datasets/chickens

# Force class ids to keep (comma separated). Leave empty for auto-detection:
# chicken/hen/poultry classes if present, otherwise the COCO "bird" class.
CHICKEN_CLASS_IDS=

CHICKEN_CONFIDENCE=0.35
CHICKEN_IOU=0.50
CHICKEN_IMGSZ=640
CHICKEN_DEVICE=cpu
# Torch threads per detector instance (lower when running several cameras)
CHICKEN_TORCH_THREADS=2

# ---------------------------------------------------------------------------
# Tracking / counting
# ---------------------------------------------------------------------------
CHICKEN_MIN_TRACK_HITS=5
CHICKEN_MAX_AGE=45
CHICKEN_N_INIT=3
CHICKEN_DEDUPE_WINDOW_S=6.0
CHICKEN_SAMPLE_INTERVAL_S=1.0

# ---------------------------------------------------------------------------
# Uploads and storage
# ---------------------------------------------------------------------------
CHICKEN_MAX_UPLOAD_MB=512

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
CHICKEN_WORKER_CONCURRENCY=2
CHICKEN_WORKER_POLL_SECONDS=2

# ---------------------------------------------------------------------------
# Optional: database, cache, sessions, TLS
# ---------------------------------------------------------------------------
# PostgreSQL (recommended for multiple workers). Defaults to SQLite.
# DB_ENGINE=postgres
# DB_NAME=chickenvision
# DB_USER=chickenvision
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_PATH=db.sqlite3

# Shared cache for rate limits across web processes (requires django-redis):
# CACHE_URL=redis://127.0.0.1:6379/1

DJANGO_SESSION_COOKIE_AGE=43200
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=0
# DJANGO_SECURE_SSL_REDIRECT=1
# DJANGO_SESSION_COOKIE_SECURE=1
# DJANGO_CSRF_COOKIE_SECURE=1
# DJANGO_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# Limits and live streaming
# ---------------------------------------------------------------------------
CHICKEN_MAX_VIDEO_SECONDS=14400
# Annotated frames published per second for live cameras
CHICKEN_LIVE_FPS=10
